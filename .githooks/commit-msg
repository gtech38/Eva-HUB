#!/usr/bin/env bash
# Commit message format:
#   <BACKLOG-ID>: <summary>          e.g. WEB-012: guardian search writes PhotoMatch on child guest
#   <type>(<scope>)?: <summary>      e.g. chore(ci): run pytest in CI   (types: feat fix chore docs refactor test ci build perf)
# Summary ≤ 72 chars, no trailing period. Merge/revert/fixup commits are exempt.
set -euo pipefail
msg_file="$1"
first=$(grep -v '^#' "$msg_file" | grep -m1 . || true)
[ -n "$first" ] || { echo "commit-msg: empty commit message." >&2; exit 1; }

case "$first" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

id_re='^(WEB|ADM|WRK|DB|SHR|INF|DOC|LEG|EPIC)-[0-9]+: .+'
cc_re='^(feat|fix|chore|docs|refactor|test|ci|build|perf)(\([a-z0-9/_.-]+\))?!?: .+'
if ! echo "$first" | grep -Eq "$id_re" && ! echo "$first" | grep -Eq "$cc_re"; then
  cat >&2 <<EOF
commit-msg: first line must be "<BACKLOG-ID>: summary" or "<type>(<scope>): summary".
  got: $first
  e.g. WEB-012: guardian search writes PhotoMatch on child guest
       chore(ci): run pytest in CI
EOF
  exit 1
fi
if [ "${#first}" -gt 72 ]; then
  echo "commit-msg: first line is ${#first} chars; keep it to 72." >&2
  exit 1
fi
if echo "$first" | grep -q '\.$'; then
  echo "commit-msg: no trailing period on the summary line." >&2
  exit 1
fi
exit 0
