# Generated by scripts/env-docs.mjs from packages/shared/src/env.ts, workers/media/hub_worker/config.py
# and scripts/env-meta.mjs. Do not edit by hand: change those, then run `pnpm env:docs`.
# Reference (defaults, secrets, production rules): docs/deploy/env.md
#
# Copy to .env — every service reads the same file (web, admin, worker, prisma).
# Commented-out lines are unset: the default shown applies.

# ─── Runtime ──────────────────────────────────────────────
# NODE_ENV=development
# APP_ENV=

# ─── Domains ──────────────────────────────────────────────
# Local: *.localhost resolves to 127.0.0.1 in Chrome/Safari/Firefox without /etc/hosts.
ROOT_DOMAIN=localhost
WEB_PORT=3000
ADMIN_PORT=3001
# Full origins (used for links in emails)
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# ─── Postgres ─────────────────────────────────────────────
# docker compose: infra/docker-compose.yml
DATABASE_URL=postgresql://hub:hub@localhost:5433/hub
# PRISMA_LOG=

# ─── Object storage ───────────────────────────────────────
# RustFS locally; any S3-compatible store in production (R2, S3, B2).
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hub-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# ─── Email ────────────────────────────────────────────────
# Mailpit locally: UI at http://localhost:8025
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Event Hub <hello@localhost>"

# ─── SMS ──────────────────────────────────────────────────
# console provider logs to stdout; real providers arrive with SHR-011
SMS_PROVIDER=console

# ─── Auth ─────────────────────────────────────────────────
AUTH_SECRET=dev-only-change-me-0123456789abcdef
SESSION_TTL_DAYS=30
# Max lifetime of a session opened from an invitation link; it also ends when the link
# itself expires (event end + 90 days, packages/shared/src/invites.ts).
INVITE_SESSION_TTL_DAYS=90

# ─── Rate limits ──────────────────────────────────────────
# packages/shared/src/ratePolicies.ts; docs/01 §9. Overrides are max/windowSec (1..1000000 / 1..604800),
# validated at server boot: a bad value stops web/admin. Per-IP limits are loose on purpose (venue
# Wi-Fi, carrier NAT); the per-address limits are the real control.
# Number of proxies that append to X-Forwarded-For; the client is that many valid entries from the right.
# TRUSTED_PROXY_HOPS=1
# Guest sign-in: per IP, per (address, IP), per address. Over the limit the reply is unchanged and nothing is sent.
# RATE_LIMIT_SIGN_IN_IP=
# RATE_LIMIT_SIGN_IN_ADDRESS_IP=
# RATE_LIMIT_SIGN_IN_ADDRESS=
# RATE_LIMIT_OTP_VERIFY_ADDRESS=
# RATE_LIMIT_INVITE_IP=
# RATE_LIMIT_FACE_SEARCH_USER=
# RATE_LIMIT_FACE_SEARCH_CONCURRENT=
# Admin magic link: per IP, per (address, IP), per address.
# RATE_LIMIT_ADMIN_MAGIC_LINK_IP=
# RATE_LIMIT_ADMIN_MAGIC_LINK_ADDRESS_IP=
# RATE_LIMIT_ADMIN_MAGIC_LINK_ADDRESS=

# ─── Worker ───────────────────────────────────────────────
WORKER_INTERNAL_URL=http://localhost:8010
WORKER_PORT=8010
FACE_MODEL_DIR=./models
# SFace cosine; OpenCV's recommended default
FACE_MATCH_THRESHOLD=0.363
# FACE_CLUSTER_DISTANCE=
# FACE_MIN_QUALITY=0.3
# WORKER_ID=
# WORKER_POLL_INTERVAL=1.0
# ZIP_PART_BYTES=2147483648
# WORKER_LOG_LEVEL=INFO

# ─── Payments ─────────────────────────────────────────────
# Placeholders; no Stripe calls are made locally.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
