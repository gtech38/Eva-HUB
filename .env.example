# Copy to .env — every service reads the same file (web, admin, worker, prisma).

# ─── Domains ───────────────────────────────────────────────
# Local: *.localhost resolves to 127.0.0.1 in Chrome/Safari/Firefox without /etc/hosts.
# Production placeholder: yourstudio.com
ROOT_DOMAIN=localhost
WEB_PORT=3000
ADMIN_PORT=3001
# Full origins (used for links in emails)
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# ─── Postgres (docker compose) ─────────────────────────────
DATABASE_URL=postgresql://hub:hub@localhost:5433/hub

# ─── Object storage (MinIO locally; any S3-compatible in prod) ─
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hub-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_FORCE_PATH_STYLE=true

# ─── Email (Mailpit locally: UI at http://localhost:8025) ──
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Event Hub <hello@localhost>"

# ─── SMS (console provider logs to stdout; swap for twilio later) ─
SMS_PROVIDER=console

# ─── Auth ──────────────────────────────────────────────────
AUTH_SECRET=dev-only-change-me-0123456789abcdef
SESSION_TTL_DAYS=30
# Max lifetime of a session opened from an invitation link; it also ends when the link
# itself expires (event end + 90 days, packages/shared/src/invites.ts).
INVITE_SESSION_TTL_DAYS=90

# Rate limits (packages/shared/src/ratePolicies.ts). Defaults shown; override as max/windowSec.
# Per-IP limits trust the first hop of X-Forwarded-For: the reverse proxy must REPLACE that header
# with the connecting address. Without the header (local dev) per-IP limits are off.
# RATE_LIMIT_SIGN_IN_ADDRESS=5/900
# RATE_LIMIT_SIGN_IN_IP=30/900
# RATE_LIMIT_OTP_VERIFY_ADDRESS=10/900
# RATE_LIMIT_INVITE_IP=60/3600
# RATE_LIMIT_FACE_SEARCH_USER=10/3600
# RATE_LIMIT_FACE_SEARCH_CONCURRENT=3/60   # 3 searches in flight; 60 s lease TTL
# RATE_LIMIT_ADMIN_MAGIC_LINK_ADDRESS=5/900

# ─── Worker ────────────────────────────────────────────────
WORKER_INTERNAL_URL=http://localhost:8010
WORKER_PORT=8010
FACE_MODEL_DIR=./models
FACE_MATCH_THRESHOLD=0.363   # SFace cosine; OpenCV's recommended default

# ─── Payments (placeholders; no Stripe calls are made locally) ─
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
